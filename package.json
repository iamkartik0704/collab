{
  "name": "collab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Collab - B2C electronics commerce platform: storefront, admin portal, inventory engine, AI support agent and omnichannel notifications.",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker:dev": "tsx watch --tsconfig tsconfig.worker.json --env-file=.env src/workers/index.ts",
    "worker:start": "tsx --tsconfig tsconfig.worker.json src/workers/index.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev --create-only && tsx scripts/check-migrations.ts && prisma migrate dev",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "ai:reindex": "tsx --tsconfig tsconfig.worker.json --env-file-if-exists=.env scripts/ai-reindex.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@hookform/resolvers": "^7.0.5",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.12.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.71.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pino": "^10.4.0",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.11",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
