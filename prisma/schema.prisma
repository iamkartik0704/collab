// =============================================================================
// Collab - PostgreSQL 16 data model
//
// Conventions
// - Money is stored as INTEGER minor units (paise / cents) in `*Minor` columns.
//   Never use floats for money; the server computes every price from these columns.
// - Percentages are basis points (`*Bps`, 1800 = 18.00%).
// - All timestamps are timestamptz(3).
// - `vector(1024)` columns are written and read with $queryRaw / $executeRaw
//   (Prisma does not map pgvector). The dimension must equal AI_EMBEDDING_DIMENSIONS.
// - Constraints Prisma cannot express (CHECKs, HNSW vector indexes, the append-only
//   trigger on AdminAuditLog/StockMovementLog) live in the SQL of the first migration.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = the dev machine; debian-openssl-3.0.x = the node:22-bookworm-slim images (Dockerfile*).
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  // Pooled connection through PgBouncer (transaction mode) - used at runtime.
  url        = env("DATABASE_URL")
  // Direct connection - used by `prisma migrate` (DDL is not PgBouncer-safe).
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

