  CYCLE_COUNT_CORRECTION
  DAMAGED
  LOST_OR_STOLEN
  RETURN_TO_VENDOR
  CUSTOMER_RETURN_RESTOCK
  SYSTEM_CORRECTION
}

enum ReservationStatus {
