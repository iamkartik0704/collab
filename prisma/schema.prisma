  CUSTOMER
  SUPPORT_AGENT
  INVENTORY_MANAGER
  SUPER_ADMIN
}

enum Currency {
  INR
  USD
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  VERIFY_PHONE
}

enum AddressType {
