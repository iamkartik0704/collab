# =============================================================================
# Collab - environment variables
# Copy to `.env` and fill in. Every variable is validated at startup by src/env.ts;
# the app and the worker refuse to boot with a missing or malformed value.
# Set SKIP_ENV_VALIDATION=1 only for `docker build` / lint steps that need no secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Canonical public origin (no trailing slash). Used for absolute links, CSRF origin checks, emails.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# trace | debug | info | warn | error | fatal | silent (tests)
LOG_LEVEL=info

# ---- PostgreSQL 16 (+ pgvector, pg_trgm) ---------------------------------------
# Runtime traffic goes through PgBouncer in transaction mode.
DATABASE_URL=postgresql://collab:collab@localhost:6432/collab?pgbouncer=true&connection_limit=10
# Direct connection for `prisma migrate` (DDL bypasses PgBouncer).
DIRECT_DATABASE_URL=postgresql://collab:collab@localhost:5432/collab

# ---- Redis 7 (cache, rate limits, locks, BullMQ) --------------------------------
REDIS_URL=redis://localhost:6379/0
# Namespace for every key the app writes (BullMQ uses its own `bull:` prefix).
REDIS_KEY_PREFIX=collab:

# ---- Auth.js v5 ------------------------------------------------------------------
# >= 32 chars. Signs/encrypts the JWT session cookie.
AUTH_SECRET=
# Set when running behind a proxy that rewrites Host (nginx). Leave empty on localhost.
AUTH_URL=
AUTH_TRUST_HOST=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Access-token (JWT) lifetime in seconds and refresh-token lifetime in days.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# >= 32 chars. HMAC pepper for refresh-token, OTP and gift-card hashes. Rotating it invalidates them.
AUTH_TOKEN_PEPPER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Payments --------------------------------------------------------------------
# Stripe: sk_test_/sk_live_ must match pk_test_/pk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Razorpay: key id is public (checkout.js), secret is server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# INR | USD
DEFAULT_CURRENCY=INR

# ---- Object storage (AWS S3, Cloudflare R2 or MinIO) ----------------------------------
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# MinIO (docker-compose.yml): S3_ENDPOINT=http://localhost:9000 S3_FORCE_PATH_STYLE=true S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=collab S3_SECRET_ACCESS_KEY=collab-minio-secret S3_PUBLIC_BASE_URL=http://localhost:9000/collab-assets
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=collab-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public CDN origin that serves the bucket (used for product images).
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_PRESIGN_TTL_SECONDS=300

# ---- WhatsApp Business Cloud API -------------------------------------------------
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret - verifies X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=
# Random string (>= 16 chars) entered in the Meta webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Email -------------------------------------------------------------------------
# resend | smtp | log   (log = print instead of send; refused in production)
EMAIL_PROVIDER=resend
EMAIL_FROM="Collab <orders@example.com>"
EMAIL_REPLY_TO=support@example.com
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# true = the worker logs WhatsApp/email deliveries instead of calling the providers (dev / CI).
NOTIFICATIONS_DRY_RUN=false

# ---- GST invoices -------------------------------------------------------------------
INVOICE_SELLER_NAME="Collab Retail Private Limited"
INVOICE_SELLER_ADDRESS="12 Residency Road, Bengaluru, Karnataka 560025, India"
# Same state as the delivery address -> CGST + SGST, otherwise IGST.
INVOICE_SELLER_STATE=Karnataka
# 15-character GSTIN printed on invoices (leave empty until registered).
INVOICE_SELLER_GSTIN=

# ---- AI support agent ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5-5
# Voyage AI embeddings. AI_EMBEDDING_DIMENSIONS must match vector(1024) in prisma/schema.prisma.
VOYAGE_API_KEY=
AI_EMBEDDING_MODEL=voyage-3.5
AI_EMBEDDING_DIMENSIONS=1024

# ---- Production stack (docker-compose.prod.yml) --------------------------------------------
# The compose file builds DATABASE_URL / DIRECT_DATABASE_URL / REDIS_URL from these.
POSTGRES_USER=collab
POSTGRES_PASSWORD=
POSTGRES_DB=collab
REDIS_PASSWORD=
# Daily pg_dump backups (service "backup"): UTC time and days to keep.
BACKUP_TIME=20:30
BACKUP_RETENTION_DAYS=14
# GHCR image coordinates (set by the deploy job).
GITHUB_REPOSITORY=
IMAGE_TAG=latest

# ---- Operations ----------------------------------------------------------------------
# Comma-separated recipients of low-stock and escalation alerts.
ADMIN_ALERT_EMAILS=ops@example.com
ADMIN_ALERT_WHATSAPP_NUMBERS=+919800000000
# Concurrent jobs per BullMQ worker process.
WORKER_CONCURRENCY=10
